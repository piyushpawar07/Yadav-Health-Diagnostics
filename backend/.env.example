# Yadav Health Diagnostics - Backend Environment Configuration

# Server running Port
PORT=3000

# JSON Web Token sign token
JWT_SECRET=yadav-diagnostics-ultra-secret-key-2026

# MONGODB_URI: MongoDB Connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/yadav-diagnostics

# SMTP Configuration for sending real password reset emails
# Gmail API (HTTPS; supports Render Free and sends as the Gmail account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_FROM=yadavhealthdiagnostics@gmail.com
# Preferred on Render Free: create a Resend API key and verify the sender domain.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yadavhealth.com
APP_URL=https://yadav-health-diagnostics.onrender.com
